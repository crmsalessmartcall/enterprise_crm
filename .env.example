# Copy to .env.local for local development. Never commit secrets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only credentials. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SIMPLE2CALL_API_URL=https://your-telephony-provider.example/api/calls
SIMPLE2CALL_API_KEY=your-telephony-api-key
